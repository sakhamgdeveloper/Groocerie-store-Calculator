list= []
a=1
disc= 0.0
print("Welcome to grocerie shop")

while(a):
  print("Please select any one option")
  print("1.) Add Vegetables in  Cart.")
  print("2.) Add Fruits in Cart.")
  print("3.) Add other items.")
  print("4.) Check items in the cart")
  print("5.) Get Bill for the present cart")
  print("6.) Restart the cart")
  f=int(input("Enter the function number you want to do?"))

  if(f==1):
    n = int(input("Enter no. of vegetables bought:"))
    for i in range (0,n):
      name = input("Enter name of vegetable ")
